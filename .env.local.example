# Copy to .env.local and fill in. Supabase dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Optional, for testing the AI categorisation tier locally.
#
# NOTE THE MISSING VITE_ PREFIX — that is the whole point. Vite only inlines
# VITE_* variables into the browser bundle, so this one is read by the dev
# server in Node and never shipped to a client. `npm run dev` serves
# api/categorise.js locally (see vite.config.js) and reads it from here.
#
# NEVER rename this to VITE_GEMINI_API_KEY. That publishes your key to anyone
# who opens DevTools on the deployed site.
#
# In production it lives in Vercel → Settings → Environment Variables, also
# without a VITE_ prefix.
# GEMINI_API_KEY=AIza...
