# Copy to .env.local and fill in. Supabase dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# GEMINI_API_KEY does NOT belong here.
# Anything prefixed VITE_ ships to the browser and will be scraped.
# It goes in Vercel → Project Settings → Environment Variables, server-side only.
