# Copy to .env.local and fill in. Supabase dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Optional, for testing the AI categorisation tier locally.
#
# NOTE THE MISSING VITE_ PREFIX — that is the whole point. Vite only inlines
# VITE_* variables into the browser bundle, so this one is read by the dev
# server in Node and never shipped to a client. `npm run dev` serves
# api/categorise.js locally (see vite.config.js) and reads it from here.
#
# NEVER rename this to VITE_GEMINI_API_KEY. That publishes your key to anyone
# who opens DevTools on the deployed site.
#
# In production it lives in Vercel → Settings → Environment Variables, also
# without a VITE_ prefix.
# GEMINI_API_KEY=AIza...

# Optional. Pins the model both functions call. Unset, they use
# `gemini-flash-lite-latest` — an alias rather than a version, because
# gemini-2.5-flash was retired for new keys mid-build and every call 404'd.
# `node scripts/list-models.mjs` lists what your key can actually call.
# GEMINI_MODEL=gemini-flash-lite-latest

# api/_auth.js verifies the caller's Supabase token using the two VITE_ values
# above, which are public and already in the browser bundle. It reads
# SUPABASE_URL / SUPABASE_ANON_KEY first if you prefer to set them separately.


# ── The approval queue ─────────────────────────────────────────────────────
#
# READ THIS FIRST: none of the six below is used by `npm run dev`. The approval
# routes live in the Cloudflare Worker (worker/access.js) and there is no dev
# shim for them, so locally a new address gets the waiting-list line and nothing
# is recorded. They are listed here only so `npm run push-secrets` can read them
# and hand them to Cloudflare — that script is the only thing that opens them.
#
# NONE OF THESE MAY EVER TAKE A VITE_ PREFIX. Two of them would hand a stranger
# your entire database if they did.

# Supabase → Project Settings → API Keys → service_role. Bypasses row level
# security and creates accounts. This is the most dangerous string in the
# project: it reads every user's every row. Worker only, never the bundle.
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Signs the Approve / Reject links in your email. Whoever knows it can mint
# their own approvals. Leave it blank and `npm run push-secrets` generates a
# strong one and writes it back here.
# APPROVE_SECRET=

# resend.com → API Keys. Sending access is enough for the approval mail; the
# inbound forwarder also reads received mail with it.
# RESEND_API_KEY=re_...

# Resend → Webhooks → the /api/inbound endpoint → Signing Secret. This is what
# proves an inbound webhook really came from Resend; without it that route is a
# public "send mail to the admin" button. Starts whsec_, and is a DIFFERENT
# string from the API key above.
# RESEND_WEBHOOK_SECRET=whsec_...

# Must be on the domain you verified in Resend, or the applicant's mail is
# accepted and silently dropped.
# MAIL_FROM=Hisaab <hello@yourdomain.com>

# Where "someone wants in" lands.
# ADMIN_EMAIL=you@example.com

# Absolute, no trailing slash. The links in those emails have to point at a
# real host, so this cannot be inferred.
# SITE_URL=https://hisaab.yourdomain.com
